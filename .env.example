# Ключи берутся только из окружения и в репозиторий не попадают.
# Скопируйте файл в .env.local и подставьте свои значения.

# Обязательный: места и снимки Google Places.
GOOGLE_PLACES_API_KEY=

# Необязательный: проверка содержимого снимков.
# Без него доверие ограничено уровнем «вероятно», профиль об этом сообщает.
GEMINI_API_KEY=

# Необязательный: подтверждение координат кампуса вторым провайдером.
TWOGIS_API_KEY=

# Необязательный: отзывы о кампусе из Google Places.
# Поле reviews тарифицируется по более дорогому SKU — значение off отключает их сбор.
PLACE_REVIEWS=
